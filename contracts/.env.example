# Copy to .env and fill in. Never commit real secrets.
#
#   cp contracts/.env.example contracts/.env
#   $EDITOR contracts/.env
#
# Then deploy with:
#   cd contracts
#   source .env
#   forge script script/Deploy.s.sol:Deploy \
#       --rpc-url "$SEPOLIA_RPC_URL" --broadcast --verify \
#       --etherscan-api-key "$ETHERSCAN_API_KEY"

# ------------------------------------------------------------------
# RPC + verification
# ------------------------------------------------------------------
# Any Sepolia RPC works. Public: https://ethereum-sepolia-rpc.publicnode.com
# Alchemy/Infura are more reliable if you have an account.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# From https://etherscan.io/myapikey — optional, but `--verify` needs it.
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------
# Deployer
# ------------------------------------------------------------------
# 0x-prefixed private key of the wallet that will pay gas for deployment.
# Wallet needs ~0.01 Sepolia ETH. Get some at https://sepoliafaucet.com
# or https://www.alchemy.com/faucets/ethereum-sepolia
DEPLOYER_PRIVATE_KEY=

# ------------------------------------------------------------------
# Contract constructor args
# ------------------------------------------------------------------
# Address of the oracle signer — the wallet the off-chain daemon will
# use to call submitVerdict(). This wallet needs a little Sepolia ETH for gas.
ORACLE_ADDRESS=

# Address that receives oracle fees on pass / partial fees on retry.
# Can be the same as ORACLE_ADDRESS for the demo if you want fewer wallets.
OPERATOR_ADDRESS=

# Optional — defaults to Sepolia USDC (0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238).
# Leave blank unless you are deploying against a different stake asset.
USDC_ADDRESS=
