# Copy to .env.supabase and paste in the values from Supabase Dashboard → Project Settings → API.
# This file is the single source for Supabase credentials; Phase 0 distributes them
# into oracle/.env, indexer/.env, and web/.env.local. Never commit the populated copy.

# Found under "Project URL"
SUPABASE_URL=

# Found under "Project API keys → anon public"
# Safe to ship to the browser (RLS enforces data access).
SUPABASE_ANON_KEY=

# Found under "Project API keys → service_role"
# Bypasses RLS. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
