# Copy to .env.local and fill in. Never commit real secrets.
#
#   cp web/.env.example web/.env.local
#   $EDITOR web/.env.local
#
# Then run:  pnpm --filter web dev

# ------------------------------------------------------------------
# On-chain
# ------------------------------------------------------------------
# Deployed Procrastinot contract on Sepolia (v2).
NEXT_PUBLIC_CONTRACT_ADDRESS=0x25DF2268051203cf73beb8cD9Cd55c313370FB26

# Sepolia USDC (Circle).
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Sepolia chain id.
NEXT_PUBLIC_CHAIN_ID=11155111

# Any Sepolia RPC. Public node is fine for the demo.
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. Enables WalletConnect in the connect-wallet modal.
# Get one free at https://cloud.walletconnect.com
# If left blank, MetaMask / Injected still works.
NEXT_PUBLIC_WALLETCONNECT_ID=

# ------------------------------------------------------------------
# Supabase (public — safe to ship to the browser; RLS enforces access)
# ------------------------------------------------------------------
# From Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# From Supabase dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# Supabase (server-only — never exposed to the browser)
# ------------------------------------------------------------------
# From Supabase dashboard → Project Settings → API → service_role (secret)
# Only used by Next.js Route Handlers / Server Actions for SIWE verification
# and admin writes. If you deploy to Vercel, set this as a Secret (not NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
