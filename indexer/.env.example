# Copy to .env and fill in. Never commit real secrets.
#
#   cp indexer/.env.example indexer/.env
#   $EDITOR indexer/.env
#
# Then run:  pnpm --filter indexer dev

# ------------------------------------------------------------------
# Chain
# ------------------------------------------------------------------
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN=sepolia

# Deployed Procrastinot contract on Sepolia (v2).
CONTRACT_ADDRESS=0x25DF2268051203cf73beb8cD9Cd55c313370FB26

# Block at which the indexer should start backfilling on first run.
# Defaults to the v2 deploy block.
START_BLOCK=10694179

# How often to poll for new head blocks (ms). 5–10s is fine on Sepolia.
POLL_INTERVAL_MS=5000

# How many blocks per getLogs chunk during backfill (public RPC limit ≈ 5000).
BACKFILL_CHUNK=5000

# ------------------------------------------------------------------
# Supabase (service-role — server only; do NOT expose to any client)
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
