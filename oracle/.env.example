# Copy to .env and fill in. Never commit real secrets.
#
#   cp oracle/.env.example oracle/.env
#   $EDITOR oracle/.env
#
# Then run:  pnpm --filter oracle dev

# Sepolia RPC. Public node is fine for the demo; Alchemy/Infura more reliable.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN=sepolia

# 0x-prefixed private key for the oracle signer (address: 0x643452c9cEC1Ea69714ad71D0387b327FAAf8076).
# Wallet needs a tiny amount of Sepolia ETH to pay gas on submitVerdict.
ORACLE_PRIVATE_KEY=

# Deployed Procrastinot contract on Sepolia.
CONTRACT_ADDRESS=0xaE8303EC8465A888E19d4A50f91053831e2269a2

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite file for dedupe state. Anywhere writable.
DB_PATH=./oracle.db

# How often to scan for new events.
POLL_INTERVAL_MS=5000

# Block number to start scanning from on first run (contract deploy block = 10693953).
START_BLOCK=10693953
